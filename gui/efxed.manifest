<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Das Anwendungsmanifest. Eingebunden ueber gui/efxed.rc (Ressource 1, Typ 24).

  Wozu: Windows und Virenscanner lesen es, bevor eine Zeile laeuft. Ohne
  eigenes Manifest legt MSVC ein knappes an; dieses sagt zusaetzlich, fuer
  welche Windows-Fassungen das Programm gebaut ist, und dass es keine
  Administratorrechte will (asInvoker) — ein Programm, das still nach mehr
  Rechten greift, ist genau das Muster, auf das Scanner anspringen.

  Bewusst NICHT darin:
  - dpiAware: das setzt announceDpiAwareness() in main_win32.cpp zur Laufzeit,
    mit Rueckfall fuer aeltere Windows-Fassungen. Zweimal setzen hiesse, dass
    das Manifest gewinnt und der Rueckfall nie laeuft.
  - activeCodePage UTF-8: wuerde die Bedeutung aller A-Aufrufe aendern. Das
    gehoert in eine eigene, gepruefte Aenderung, nicht in diese.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="EffectsEd.Remake.efxed" version="1.0.0.0" processorArchitecture="*"/>
  <description>EffectsEd - editor for Jedi Academy effect files</description>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v3">
    <security>
      <requestedPrivileges>
        <requestedExecutionLevel level="asInvoker" uiAccess="false"/>
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 und 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
    </application>
  </compatibility>
</assembly>
